{
  "name": "xt-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Privacy-first developer and everyday tools that run entirely in your browser.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xeptor6569/xt-tools.git"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.ts",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate-tools": "node scripts/validate-tools.ts",
    "new-tool": "node scripts/new-tool.ts",
    "remove-tool": "node scripts/remove-tool.ts",
    "list-tools": "node scripts/list-tools.ts",
    "check-licenses": "node scripts/check-licenses.ts",
    "smoke": "node scripts/smoke-test.ts",
    "prepare": "node scripts/setup-hooks.ts",
    "batch-tools": "node scripts/batch-tools.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "croner": "10.0.1",
    "cronstrue": "3.32.0",
    "culori": "4.0.2",
    "diff": "8.0.4",
    "dompurify": "3.4.17",
    "emojibase-data": "18.0.0",
    "fast-xml-parser": "5.11.2",
    "figlet": "1.12.0",
    "js-xxhash": "5.0.1",
    "marked": "18.1.1",
    "preact": "10.29.8",
    "smol-toml": "1.9.1",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "uqr": "0.1.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/preact": "6.0.6",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/culori": "4.0.1",
    "@types/node": "26.6.5",
    "@types/turndown": "5.0.6",
    "astro": "7.3.8",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.13.0",
    "hash-wasm": "4.12.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "fsevents": false
  }
}
