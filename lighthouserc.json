{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8080/",
        "http://localhost:8080/category/development/",
        "http://localhost:8080/tools/json-format/",
        "http://localhost:8080/tools/color-converter/",
        "http://localhost:8080/tools/crontab/",
        "http://localhost:8080/tools/hash-text/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "errors-in-console": ["error", { "maxLength": 0 }],
        "total-byte-weight": ["warn", { "maxNumericValue": 512000 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
