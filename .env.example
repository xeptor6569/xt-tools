# Copy to .env and adjust. Used by compose.yaml and the Makefile.

# Image tag to run. Leave unset to build and run your local checkout;
# set to a published tag (latest, 1.2, 1.2.3, edge) to run a release.
# XT_TAG=latest
# Image name (without tag). The CI deploy job uses its local build, xt-tools.
# XT_IMAGE=ghcr.io/xeptor6569/xt-tools

# Address and port on the host.
XT_BIND=0.0.0.0
XT_PORT=8080

# Serve under a sub-path, e.g. /tools/. Compiled into the site: rebuild after
# changing it (make build). Must start and end with "/".
BASE_PATH=/

# Public URL, used for canonical links. Optional.
SITE_URL=

# Version shown in the footer of local builds.
VERSION=dev

# Domain for the HTTPS overlay (compose.https.yaml). A public name gets a
# Let's Encrypt certificate. A LAN name uses the tls internal block in
# deploy/Caddyfile, then: make caddy-ca
DOMAIN=tools.example.com
