---
import { getCategory, getGroup } from '../categories.ts';
import Icon from '../components/site/Icon.astro';
import PinButton from '../components/site/PinButton.astro';
import SaveTool from '../components/site/SaveTool.astro';
import CapabilityNotice from '../components/ui/CapabilityNotice.tsx';
import LegacyWarning from '../components/ui/LegacyWarning.astro';
import { categoryHref, href } from '../lib/href.ts';
import { formatHostList } from '../lib/network-allow.ts';
import type { ToolMeta } from '../tools/types.ts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  meta: ToolMeta;
}

const { meta } = Astro.props;
const category = getCategory(meta.category);
const group = meta.group && category ? getGroup(category.id, meta.group) : undefined;
const requires = meta.requires ?? [];
---

<BaseLayout title={meta.name} description={meta.description}>
  <nav aria-label="Breadcrumb" class="mb-4 text-sm">
    <ol class="flex flex-wrap items-center gap-1 text-muted">
      <li>
        <a href={href()}>Home</a>
      </li>
      <li aria-hidden="true">›</li>
      {category && (
        <>
          <li>
            <a href={categoryHref(category.id)}>{category.label}</a>
          </li>
          <li aria-hidden="true">›</li>
        </>
      )}
      {category && group && (
        <>
          <li>
            <a href={`${categoryHref(category.id)}#${group.id}`}>{group.label}</a>
          </li>
          <li aria-hidden="true">›</li>
        </>
      )}
      <li aria-current="page" class="text-fg">
        {meta.name}
      </li>
    </ol>
  </nav>

  <header class="mb-6 flex flex-col gap-2">
    <div class="flex flex-wrap items-center gap-2">
      <h1 class="text-2xl font-bold">{meta.name}</h1>
      <PinButton kind="tool" id={meta.id} label={meta.name} />
      <SaveTool id={meta.id} name={meta.name} labelled />
    </div>
    <p class="text-muted">{meta.description}</p>
  </header>

  <div class="mb-6 flex flex-col gap-3 empty:hidden">
    {requires.length > 0 && <CapabilityNotice client:load requires={requires} />}
    {meta.legacy && <LegacyWarning text={meta.legacy} />}
    {meta.sensitive && (
      <p class="flex items-center gap-2 text-sm text-muted">
        <Icon name="shield" class="size-4 shrink-0" />
        Sensitive tool: input is never stored or put in the URL.
      </p>
    )}
    {meta.network && (
      <p role="note" data-xt="network" class="rounded-lg border border-border bg-surface p-3 text-sm text-fg">
        <strong>Network.</strong> When you run this tool it contacts {formatHostList(meta.network.hosts)}. Nothing is
        sent until then, and the request carries no cookies. The rest of the site stays on this device.
      </p>
    )}
  </div>

  {/* min-h-screen keeps the footer below the fold, so output that appears after hydration doesn't shift it (CLS). */}
  <section aria-label="Tool" translate="no" class="min-h-screen" data-xt-tool={meta.id}>
    <slot />
  </section>
  <script>
    import { recordStoredRecent } from '../lib/recents-store.ts';

    const id = document.querySelector('[data-xt-tool]')?.getAttribute('data-xt-tool');
    if (id) recordStoredRecent(id);
  </script>
</BaseLayout>
