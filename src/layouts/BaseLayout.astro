---
import '../styles/global.css';
import { categories } from '../categories.ts';
import Pins from '../components/site/Pins.astro';
import ThemeSwitch from '../components/site/ThemeSwitch.astro';
import { buttonClass } from '../components/ui/Button.tsx';
import { categoryHref, collectionsHref, href } from '../lib/href.ts';
import { themeBootstrapScript } from '../lib/theme.ts';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const fullTitle = title === 'xt-tools' ? title : `${title} · xt-tools`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const version = __XT_VERSION__;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={`xt-tools ${version}`} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('icons/apple-touch-icon.png')} />
    <link rel="manifest" href={href('manifest.webmanifest')} />
    <meta name="theme-color" content="#1d4ed8" />
  </head>
  <body class="flex min-h-screen flex-col">
    {/* Runs before first paint. It's in <body> because Astro adds the CSP <meta> at the end of <head>. */}
    <script is:inline set:html={themeBootstrapScript(import.meta.env.BASE_URL)} />
    <a
      href="#main"
      class="sr-only rounded bg-accent px-3 py-2 text-accent-fg focus:not-sr-only focus:absolute focus:top-2 focus:left-2"
    >
      Skip to content
    </a>
    <div data-xt="offline-banner" hidden class="bg-warning-bg text-warning" role="status">
      <p class="mx-auto max-w-6xl px-4 py-2 text-sm">Offline mode needs HTTPS.</p>
    </div>
    <div data-xt="update" hidden class="border-b border-border bg-surface" role="status">
      <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-2">
        <p class="text-sm text-fg">Update available, reload</p>
        <button type="button" data-xt="update-reload" class={buttonClass('primary')}>
          Reload
        </button>
      </div>
    </div>
    <header class="border-b border-border">
      <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3">
        <a href={href()} class="text-lg font-bold text-fg no-underline">
          xt-tools
        </a>
        <span class="hidden text-sm text-muted lg:inline">Your toolbox, your server, no internet required.</span>
        <nav aria-label="Site" class="ml-auto flex flex-wrap items-center justify-end gap-4">
          <button
            type="button"
            data-xt="search-open"
            class={buttonClass()}
            aria-haspopup="dialog"
            aria-keyshortcuts="Control+K Meta+K /"
          >
            Search
            <kbd class="hidden rounded border border-border px-1.5 font-mono text-xs sm:inline">Ctrl K</kbd>
          </button>
          <a href={collectionsHref()} class="text-sm text-fg no-underline hover:underline">
            Collections
          </a>
          <a href={href('settings/')} class="text-sm text-fg no-underline hover:underline">
            Settings
          </a>
          <ThemeSwitch />
        </nav>
      </div>
    </header>
    <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-6">
      <slot />
    </main>
    <footer class="border-t border-border">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-4 text-sm text-muted">
        <nav aria-label="Categories">
          <ul class="flex flex-wrap gap-x-4 gap-y-1">
            {categories.map((c) => (
              <li>
                <a href={categoryHref(c.id)}>{c.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <p>
          Tools run in your browser. Network tools say so and run only when you ask. ·{' '}
          <a href={collectionsHref()}>Collections</a> · <a href={href('settings/')}>Settings</a> ·{' '}
          <a href={href('licenses/')}>Licenses</a> · v{version}
        </p>
      </div>
    </footer>
    <dialog
      data-xt="search-dialog"
      aria-labelledby="xt-search-title"
      class="w-[min(36rem,calc(100vw-2rem))] rounded-lg border border-border bg-bg p-4 text-fg backdrop:bg-fg/40"
    >
      <div class="mb-3 flex items-center gap-3">
        <h2 id="xt-search-title" class="text-lg font-semibold">
          Search tools
        </h2>
        <button type="button" data-xt="search-close" class={`${buttonClass()} ml-auto`}>
          Close
        </button>
      </div>
      <label for="xt-search-input" class="sr-only">
        Search tools
      </label>
      <input
        id="xt-search-input"
        data-xt="search-input"
        type="search"
        role="combobox"
        autocomplete="off"
        spellcheck="false"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="xt-search-results"
        placeholder="Name, keyword or description"
        class="min-h-11 w-full rounded-md border border-border bg-bg px-3 text-fg"
      />
      <p data-xt="search-status" class="sr-only" aria-live="polite"></p>
      <p data-xt="search-hint" class="mt-3 text-sm text-muted"></p>
      <ul id="xt-search-results" role="listbox" data-xt="search-results" class="mt-2 flex flex-col gap-1"></ul>
    </dialog>
    <Pins />
    <script>
      import { installSearch } from '../components/site/search-boot.ts';
      import { startShell } from '../lib/pwa.ts';

      installSearch();
      startShell();
    </script>
    <noscript>
      <p class="mx-auto max-w-6xl px-4 pb-4 text-sm">
        The tools on this site need JavaScript. The pages still list what each tool does.
      </p>
    </noscript>
  </body>
</html>
