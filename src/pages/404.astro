---
import { categories } from '../categories.ts';
import { buttonClass } from '../components/ui/Button.tsx';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categoryHref, href } from '../lib/href.ts';
---

<BaseLayout title="Page not found" description="The page you were looking for does not exist.">
  <h1 class="mb-2 text-3xl font-bold">Page not found</h1>
  <p class="mb-6 text-muted">
    That page doesn’t exist. Search for a tool above, go back to <a href={href()}>all tools</a>, or pick a category.
  </p>
  <ul class="flex flex-wrap gap-2">
    {categories.map((c) => (
      <li>
        <a href={categoryHref(c.id)}>{c.label}</a>
      </li>
    ))}
  </ul>
  <div class="mt-8 flex flex-col items-start gap-3 border-t border-border pt-6" data-xt="hash-snake">
    <p class="text-sm text-muted">The bits that were on this page have wandered off.</p>
    <button type="button" class={buttonClass('secondary')} data-xt="hash-snake-start">
      Chase the bits
    </button>
    <div class="flex w-full flex-col gap-3" data-xt="hash-snake-root"></div>
  </div>
  <script>
    const start = document.querySelector('[data-xt="hash-snake-start"]');
    start?.addEventListener('click', async () => {
      const root = document.querySelector('[data-xt="hash-snake-root"]');
      if (!root || !(start instanceof HTMLButtonElement)) return;
      start.disabled = true;
      const { mountHashSnake } = await import('../components/site/hash-snake.ts');
      start.remove();
      mountHashSnake(root);
    });
  </script>
</BaseLayout>
