---
import { categories } from '../categories.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categoryHref, href } from '../lib/href.ts';
---

<BaseLayout title="Page not found" description="The page you were looking for does not exist.">
  <h1 class="mb-2 text-3xl font-bold">Page not found</h1>
  <p class="mb-6 text-muted">
    That page doesn’t exist. Search for a tool, go back to <a href={href()}>all tools</a>, or pick a category.
  </p>
  <div class="mb-6 max-w-md">
    <label for="not-found-search" class="mb-1 block text-sm font-medium">
      Search tools
    </label>
    <input
      id="not-found-search"
      data-xt="search-field"
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder="Name, keyword or description"
      class="min-h-11 w-full rounded-md border border-border bg-bg px-3 text-fg"
    />
  </div>
  <ul class="flex flex-wrap gap-2">
    {categories.map((c) => (
      <li>
        <a href={categoryHref(c.id)}>{c.label}</a>
      </li>
    ))}
  </ul>
</BaseLayout>
