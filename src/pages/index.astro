---
import Icon from '../components/site/Icon.astro';
import PinButton from '../components/site/PinButton.astro';
import ToolGroups from '../components/site/ToolGroups.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categoryHref, collectionsHref } from '../lib/href.ts';
import { allTools, toolsByCategory } from '../tools/registry.ts';

const groups = toolsByCategory().filter((g) => g.tools.length > 0);
const total = allTools().length;
---

<BaseLayout
  title="xt-tools"
  description="Privacy-first developer and everyday tools that run in your browser. No tracking. A tool marked Network names the service it contacts and runs only when you ask."
>
  <h1 class="mb-2 text-3xl font-bold">Tools</h1>
  <p class="mb-6 text-muted">
    {total}
    {total === 1 ? 'tool' : 'tools'}. Most run entirely in this browser. A card marked Network sends your query to the
    service named on its page, and only after you run it. Pin a tool, group or category to keep it at the top of this
    page.
  </p>

  <div data-xt="pinned"></div>

  <section data-xt="recent" hidden class="mb-8" aria-labelledby="recent-title">
    <h2 id="recent-title" class="mb-3 text-xl font-semibold">
      Recent
    </h2>
    <ul data-xt="recent-list" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></ul>
  </section>

  <section aria-labelledby="your-collections" class="mb-8">
    <div class="mb-2 flex flex-wrap items-center gap-3">
      <h2 id="your-collections" class="text-xl font-semibold">
        Your collections
      </h2>
      <a href={collectionsHref()} class="text-sm">
        Manage
      </a>
    </div>
    <ul data-xt="collection-list" class="mb-2 flex flex-wrap gap-2 empty:hidden"></ul>
    <p class="text-sm text-muted">
      Collections and sub-collections you create stay on this device.
      <a href={collectionsHref()}>Create one</a>
    </p>
  </section>

  <nav aria-label="Jump to a category" class="sticky top-0 z-10 -mx-4 mb-8 border-b border-border bg-bg px-4 py-3">
    <ul class="flex flex-wrap gap-2">
      {groups.map(({ category, tools }) => (
        <li>
          <a
            href={`#cat-${category.id}`}
            class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-3 py-1.5 text-sm text-fg no-underline hover:border-accent"
          >
            <Icon name={category.icon} class="size-4" />
            {category.label}
            <span class="text-muted">({tools.length})</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  {groups.map(({ category, tools }) => (
    <section class="mb-10 scroll-mt-24" id={`cat-${category.id}`} aria-labelledby={`cat-${category.id}-title`}>
      <div class="mb-3 flex items-center gap-2">
        <h2 id={`cat-${category.id}-title`} class="flex items-center gap-2 text-xl font-semibold">
          <a
            href={categoryHref(category.id)}
            class="inline-flex items-center gap-2 text-fg no-underline hover:text-accent"
          >
            <Icon name={category.icon} />
            {category.label}
          </a>
        </h2>
        <PinButton kind="category" id={category.id} label={`the ${category.label} category`} />
      </div>
      <ToolGroups category={category} tools={tools} />
    </section>
  ))}

  <script>
    import { mountHomePersonal } from '../components/site/mount-home.ts';

    mountHomePersonal();
  </script>
</BaseLayout>
