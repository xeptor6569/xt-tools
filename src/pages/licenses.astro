---
import { shippedPackages } from '../../scripts/lib/licenses.ts';
import BaseLayout from '../layouts/BaseLayout.astro';

// The bundled page can't use import.meta.dirname, so resolve from the project root.
const packages = shippedPackages(process.cwd());

const bundled = [
  {
    name: 'Lucide icons',
    license: 'ISC',
    homepage: 'https://lucide.dev',
    note: 'Category and UI icons (copied, v1.57.0).',
  },
  {
    name: 'github/gitignore',
    license: 'CC0-1.0',
    homepage: 'https://github.com/github/gitignore',
    note: '.gitignore templates used by the .gitignore generator (commit 0e5d690). See docs/datasets.md.',
  },
  {
    name: 'Kubernetes OpenAPI spec',
    license: 'Apache-2.0',
    homepage: 'https://github.com/kubernetes/kubernetes',
    note: 'API schemas derived from api/openapi-spec/swagger.json (v1.37.1) by the Kubernetes Authors, reduced and modified for the manifest validator. See docs/datasets.md.',
  },
  {
    name: 'IEEE Registration Authority MAC lists',
    license: 'IEEE public registry data',
    homepage: 'https://standards.ieee.org/products-programs/regauth/',
    note: 'MA-L, MA-M and MA-S assignments bundled for the MAC vendor lookup (oui-2026-10). See docs/datasets.md.',
  },
  {
    name: 'EFF Large Wordlist',
    license: 'CC-BY-4.0',
    homepage: 'https://www.eff.org/deeplinks/2016/07/new-wordlists-random-passphrases',
    note: '7,776-word Diceware list by the Electronic Frontier Foundation, also offered under CC-BY-3.0. Bundled in the Diceware tool and never fetched at runtime.',
  },
];
---

<BaseLayout title="Licenses" description="Open source software and data bundled with xt-tools, with their licenses.">
  <h1 class="mb-2 text-3xl font-bold">Licenses</h1>
  <p class="mb-6 text-muted">
    xt-tools is released under the MIT license. It ships the following open source software and data.
  </p>

  <h2 class="mb-3 text-xl font-semibold">Packages</h2>
  <table class="mb-8 w-full border-collapse text-left text-sm">
    <thead>
      <tr class="border-b border-border">
        <th scope="col" class="py-2 pr-4">
          Package
        </th>
        <th scope="col" class="py-2 pr-4">
          Version
        </th>
        <th scope="col" class="py-2">
          License
        </th>
      </tr>
    </thead>
    <tbody>
      {packages.map((p) => (
        <tr class="border-b border-border">
          <td class="py-2 pr-4">{p.homepage ? <a href={p.homepage}>{p.name}</a> : p.name}</td>
          <td class="py-2 pr-4 font-mono">{p.version}</td>
          <td class="py-2">{p.license}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2 class="mb-3 text-xl font-semibold">Bundled assets and data</h2>
  <ul class="list-disc pl-5 text-sm">
    {bundled.map((b) => (
      <li>
        <a href={b.homepage}>{b.name}</a> ({b.license}): {b.note}
      </li>
    ))}
  </ul>
</BaseLayout>
