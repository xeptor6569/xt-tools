---
import { categories } from '../../categories.ts';
import Icon from '../../components/site/Icon.astro';
import PinButton from '../../components/site/PinButton.astro';
import ToolGroups from '../../components/site/ToolGroups.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { href } from '../../lib/href.ts';
import { toolsInCategory } from '../../tools/registry.ts';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { id: category.id }, props: { category } }));
}

const { category } = Astro.props;
const tools = toolsInCategory(category.id);
---

<BaseLayout title={category.label} description={category.description}>
  <nav aria-label="Breadcrumb" class="mb-4 text-sm">
    <ol class="flex items-center gap-1 text-muted">
      <li>
        <a href={href()}>Home</a>
      </li>
      <li aria-hidden="true">›</li>
      <li aria-current="page" class="text-fg">
        {category.label}
      </li>
    </ol>
  </nav>
  <div class="mb-2 flex flex-wrap items-center gap-2">
    <h1 class="flex items-center gap-2 text-3xl font-bold">
      <Icon name={category.icon} class="size-7" />
      {category.label}
    </h1>
    <PinButton kind="category" id={category.id} label={`the ${category.label} category`} />
  </div>
  <p class="mb-6 text-muted">{category.description}</p>
  {tools.length > 0 ? (
    <ToolGroups category={category} tools={tools} anchorGroups describe level={2} />
  ) : (
    <p>No tools in this category yet.</p>
  )}
</BaseLayout>
