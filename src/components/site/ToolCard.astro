---
import { toolHref } from '../../lib/href.ts';
import { isNew } from '../../tools/registry.ts';
import type { ToolMeta } from '../../tools/types.ts';
import PinButton from './PinButton.astro';
import SaveTool from './SaveTool.astro';
import TagList from './TagList.astro';

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;
---

<li class="flex h-full flex-col rounded-lg border border-border bg-surface hover:border-accent">
  <a href={toolHref(tool.id)} class="flex flex-1 flex-col gap-2 p-4 text-fg no-underline">
    <span class="flex items-center gap-2 font-semibold">
      <span>{tool.name}</span>
      {tool.network && (
        <span class="rounded-full border border-border px-2 py-0.5 text-xs font-medium text-muted">Network</span>
      )}
      {isNew(tool) && (
        <span class="ml-auto rounded-full bg-accent px-2 py-0.5 text-xs font-semibold text-accent-fg">New</span>
      )}
    </span>
    <span class="text-sm text-muted">{tool.description}</span>
  </a>
  <div class="flex items-center gap-1 border-t border-border px-2 py-1">
    <TagList tags={tool.tags} />
    <PinButton kind="tool" id={tool.id} label={tool.name} />
    <SaveTool id={tool.id} name={tool.name} />
  </div>
</li>
