---
import { getCategory } from '../../categories.ts';
import { toolHref } from '../../lib/href.ts';
import { isNew } from '../../tools/registry.ts';
import type { ToolMeta } from '../../tools/types.ts';
import Icon from './Icon.astro';

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;
const category = getCategory(tool.category);
---

<li>
  <a
    href={toolHref(tool.id)}
    class="flex h-full flex-col gap-2 rounded-lg border border-border bg-surface p-4 text-fg no-underline hover:border-accent"
  >
    <span class="flex items-center gap-2 font-semibold">
      {category && <Icon name={category.icon} class="size-4 shrink-0 text-muted" />}
      <span>{tool.name}</span>
      {isNew(tool) && (
        <span class="ml-auto rounded-full bg-accent px-2 py-0.5 text-xs font-semibold text-accent-fg">New</span>
      )}
    </span>
    <span class="text-sm text-muted">{tool.description}</span>
  </a>
</li>
