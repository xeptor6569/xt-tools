---
import { collectionsHref } from '../../lib/href.ts';
import Icon from './Icon.astro';

interface Props {
  id: string;
  name: string;
  /** Show the action as text beside the icon. */
  labelled?: boolean;
}

const { id, name, labelled = false } = Astro.props;
const label = `Add ${name} to a collection`;
---

<a
  href={collectionsHref(`add-${id}`)}
  class:list={[
    'inline-flex shrink-0 items-center justify-center rounded-md text-muted no-underline hover:bg-bg hover:text-fg',
    labelled ? 'min-h-9 gap-2 border border-border px-3 text-sm' : 'size-8',
  ]}
  aria-label={label}
  title={label}
>
  <Icon name="folder-plus" class="size-4" />
  {labelled && <span>Add to collection</span>}
</a>
