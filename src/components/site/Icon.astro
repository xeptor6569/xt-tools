---
import { icons, type IconName } from '../../icons.ts';

interface Props {
  name: IconName;
  class?: string;
  /** Accessible label. Omit for decorative icons. */
  label?: string;
}

const { name, class: className = 'size-5', label } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={icons[name]}
/>
