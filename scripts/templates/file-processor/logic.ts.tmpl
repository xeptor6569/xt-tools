import { ToolInputError } from '../types.ts';

export interface FileFact {
  label: string;
  value: string;
}

export const MAX_BYTES = 100 * 1024 * 1024;

/**
 * XT-TODO: implement __NAME__. Inspect or transform the file's bytes.
 *
 * Keep this a pure function: no DOM, no framework, no storage. Throw
 * ToolInputError with a helpful message when the file can't be processed.
 */
export function __FN__(bytes: Uint8Array, name: string): FileFact[] {
  if (bytes.length > MAX_BYTES) throw new ToolInputError('File is too large (maximum 100 MB).');
  const head = [...bytes.subarray(0, 16)].map((b) => b.toString(16).padStart(2, '0')).join(' ');
  return [
    { label: 'Name', value: name },
    { label: 'Size', value: `${bytes.length} bytes` },
    { label: 'First bytes', value: head || '(empty file)' },
  ];
}
