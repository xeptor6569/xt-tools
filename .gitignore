# ---------------------------------------------
# Dependencies
# ---------------------------------------------
node_modules/
.pnpm-store/
.npm/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------
# Build output
# ---------------------------------------------
dist/
out/
.astro/
.vite/
*.tsbuildinfo

# PWA / service worker generated files (rebuilt every build)
dev-dist/

# ---------------------------------------------
# Testing
# ---------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
.lighthouseci/

# ---------------------------------------------
# Environment and secrets
# ---------------------------------------------
.env
.env.*
!.env.example
!deploy/.env.example
*.pem
*.key
*.crt
!tests/fixtures/**/*.pem

# ---------------------------------------------
# Docker artifacts
# ---------------------------------------------
# Exported images for air-gapped installs (make export)
offline-tools.tar.gz
*.tar
*.tar.gz
!tests/fixtures/**/*.tar.gz

# Local compose overrides
compose.override.yaml
docker-compose.override.yml

# Caddy local data if bind-mounted instead of using volumes
deploy/caddy_data/
deploy/caddy_config/

# ---------------------------------------------
# Release artifacts
# ---------------------------------------------
dist.zip
release/
*.zip
!tests/fixtures/**/*.zip

# ---------------------------------------------
# Logs and debug
# ---------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------
# Caches
# ---------------------------------------------
.cache/
.eslintcache
.stylelintcache
.prettiercache
.turbo/

# ---------------------------------------------
# Editors and IDEs
# ---------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# ---------------------------------------------
# OS files
# ---------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------
# Misc
# ---------------------------------------------
.temp/
.tmp/
*.local
